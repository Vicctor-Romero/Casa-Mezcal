---
// Una tarjeta de platillo. La usan los destacados del landing y la página /menu.
// Si el platillo trae `image`, la tarjeta se vuelve expandible (details nativo):
// miniatura + tap para ver la foto grande. Sin foto: tarjeta de texto normal.
import { Image } from 'astro:assets';
import type { MenuItem } from '../data/menu';

type Props = MenuItem;
const { name, price, priceLabel, desc, image } = Astro.props;
const priceText = priceLabel ?? (price != null ? `$${price.toFixed(2)}` : '');
---

{image ? (
  <details class="group bg-cream-2 border border-border-warm rounded-xl overflow-hidden">
    <summary class="flex items-center gap-3 px-3 py-2.5 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
      <Image src={image} alt={name} width={120} class="w-14 h-14 rounded-lg object-cover shrink-0" />
      <div class="flex-1 min-w-0">
        <div class="flex items-baseline justify-between gap-3">
          <span class="font-bold text-[14.5px]">{name}</span>
          <span class="font-display font-black text-[14.5px] text-terracotta-dark whitespace-nowrap">{priceText}</span>
        </div>
        {desc && (
          <div class="text-[12.5px] text-muted mt-[3px] leading-[1.45] line-clamp-1 group-open:line-clamp-none" data-es={desc.es}>
            {desc.en}
          </div>
        )}
      </div>
      <svg class="w-4 h-4 text-tan shrink-0 transition-transform group-open:rotate-180" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M5 7.5 10 12.5 15 7.5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </summary>
    <div class="px-3 pb-3">
      <Image
        src={image}
        alt={name}
        widths={[400, 800]}
        sizes="(min-width: 900px) 50vw, 100vw"
        class="w-full max-h-[380px] object-cover rounded-lg"
      />
    </div>
  </details>
) : (
  <div class="bg-cream-2 border border-border-warm rounded-xl px-4 py-[13px]">
    <div class="flex items-baseline justify-between gap-3">
      <span class="font-bold text-[14.5px]">{name}</span>
      <span class="font-display font-black text-[14.5px] text-terracotta-dark whitespace-nowrap">{priceText}</span>
    </div>
    {desc && <div class="text-[12.5px] text-muted mt-[3px] leading-[1.45]" data-es={desc.es}>{desc.en}</div>}
  </div>
)}
